    "@types/node": "^24.0.0",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
