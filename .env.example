# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# MongoDB — use a real URI, or `memory` for local in-memory Mongo (no Docker needed)
MONGODB_URI=memory
# MONGODB_URI=mongodb://127.0.0.1:27017/kalibri_texnika

# Redis (optional locally — falls back to memory; required for multi-instance + 1M scale)
REDIS_URL=redis://127.0.0.1:6379

# Cache
CACHE_TTL_SECONDS=60

# Cloudflare R2 (S3-compatible) for product images
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=kalibri-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.example.com
CLOUDFLARE_R2_ENDPOINT=

# Auth / Telegram (never commit real token)
TELEGRAM_BOT_TOKEN=
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PHONE=+998947932005
AUTH_CODE_TTL_SECONDS=300
