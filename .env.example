# ─── Server ───────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# Frontend origin(s) for CORS + links. Comma-separated if multiple.
# Production store: https://kalibri-f.vercel.app
FRONTEND_URL=http://localhost:3000
# CORS_ORIGIN defaults to FRONTEND_URL if unset; include production + local when needed:
# CORS_ORIGIN=https://kalibri-f.vercel.app,http://localhost:3000

# Public site URL (SEO sitemap / canonical on API side)
SITE_URL=http://localhost:3000

# Telegram Mini App / Do'kon web_app URL (must be HTTPS). Falls back to FRONTEND_URL.
# Production:
TELEGRAM_WEBAPP_URL=https://kalibri-f.vercel.app
# Local HTTPS tunnel (dev only): npm run tunnel:webapp → paste that URL here instead.

# Set true only to auto-insert demo categories/products on empty DB
SEED_DEMO_CATALOG=false

# ─── MongoDB ──────────────────────────────────────────────
# Use a real URI in production, or `memory` for local in-memory Mongo
MONGODB_URI=memory
# MONGODB_URI=mongodb://127.0.0.1:27017/kalibri_texnika
# Force in-memory even if MONGODB_URI is set:
# USE_IN_MEMORY_MONGO=true

# ─── Redis (optional locally — memory fallback; needed for multi-instance) ──
REDIS_URL=redis://127.0.0.1:6379

# Cache TTL (seconds)
CACHE_TTL_SECONDS=60

# ─── Cloudflare R2 (product images) ───────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=kalibri-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.example.com
CLOUDFLARE_R2_ENDPOINT=

# ─── Auth / Telegram (never commit real secrets) ──────────
TELEGRAM_BOT_TOKEN=
JWT_SECRET=change-me-to-a-long-random-string
SUPER_ADMIN_PHONE=+998900000000
ADMIN_PHONE=+998900000000
AUTH_CODE_TTL_SECONDS=300

# Optional: enable agentDebugLog stdout (off by default)
# AGENT_DEBUG=true
